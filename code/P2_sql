
-- ============================================================
-- SEIS 732 - Fall 2026
-- Project P2: Raw to Curated Build
--
-- Project: universal-code-508122-p8
-- Dataset: books_project
-- Dataset location: US
-- Raw table: books
-- Curated table: books_curated
-- Supporting table: books_final
-- Last executed: November 20, 2026
--
-- PURPOSE:
-- Inspect the Raw input, investigate and establish the
-- provisional analytical grain, build and validate Curated,
-- and create a supporting table with parsed publication
-- and copyright years.
--
-- IMPORTANT:
-- The source contains 2,000,000 sampled records, not the
-- complete Seattle Public Library checkout dataset.
-- Checkout year/month represent activity dates.
-- Publication year represents the book's publication date.
-- ============================================================


-- ============================================================
-- SECTION 1. SOURCE INSPECTION AND GRAIN INVESTIGATION
-- ============================================================

-- 1.1 Inspect Raw table size and checkout-year coverage

SELECT
  COUNT(*) AS total_rows,
  COUNTIF(checkouts IS NULL) AS missing_checkouts,
  COUNTIF(checkouts < 0) AS negative_checkouts,
  COUNT(DISTINCT checkoutyear) AS distinct_years,
  MIN(checkoutyear) AS first_year,
  MAX(checkoutyear) AS last_year
FROM `universal-code-508122-p8.books_project.books`;


-- 1.2 Test the original P1 proposed grain
-- Original grain:
-- title + creator + checkoutmonth + checkoutyear
-- + materialtype + checkouttype + usageclass

WITH grain_groups AS (
  SELECT
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,
    COUNT(*) AS source_rows,
    SUM(checkouts) AS total_checkouts
  FROM `universal-code-508122-p8.books_project.books`
  GROUP BY
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass
)

SELECT
  COUNTIF(source_rows > 1) AS repeated_grain_groups,
  SUM(IF(source_rows > 1, source_rows, 0))
    AS rows_in_repeated_groups,
  SUM(IF(source_rows > 1, source_rows - 1, 0))
    AS extra_rows,
  MAX(source_rows) AS largest_group_size
FROM grain_groups;


-- 1.3 Inspect records sharing the original proposed grain
-- This helps identify catalog attributes that differ
-- within the original proposed grain.

SELECT
  usageclass,
  checkouttype,
  materialtype,
  checkoutyear,
  checkoutmonth,
  title,
  creator,
  isbn,
  publisher,
  subjects,
  publicationyear,
  checkouts,

  COUNT(*) OVER (
    PARTITION BY
      title,
      creator,
      checkoutmonth,
      checkoutyear,
      materialtype,
      checkouttype,
      usageclass
  ) AS proposed_grain_count

FROM `universal-code-508122-p8.books_project.books`

QUALIFY proposed_grain_count > 1

ORDER BY
  proposed_grain_count DESC,
  title,
  checkoutyear,
  checkoutmonth

LIMIT 100;


-- 1.4 Summarize differences within repeated original-grain groups

WITH repeated_groups AS (
  SELECT
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,

    COUNT(*) AS source_rows,
    COUNT(DISTINCT subjects) AS distinct_subjects,
    COUNT(DISTINCT checkouts) AS distinct_checkout_values,
    COUNT(DISTINCT isbn) AS distinct_isbns,
    COUNT(DISTINCT publisher) AS distinct_publishers,
    COUNT(DISTINCT publicationyear) AS distinct_publication_years,

    COUNT(DISTINCT TO_JSON_STRING(STRUCT(
      isbn,
      publisher,
      subjects,
      publicationyear,
      checkouts
    ))) AS distinct_full_record_variants

  FROM `universal-code-508122-p8.books_project.books`

  GROUP BY
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass

  HAVING COUNT(*) > 1
)

SELECT
  COUNT(*) AS repeated_grain_groups,
  SUM(source_rows) AS rows_in_repeated_groups,

  COUNTIF(distinct_subjects > 1)
    AS groups_with_multiple_subjects,

  COUNTIF(distinct_checkout_values > 1)
    AS groups_with_multiple_checkout_values,

  COUNTIF(distinct_isbns > 1)
    AS groups_with_multiple_isbns,

  COUNTIF(distinct_publishers > 1)
    AS groups_with_multiple_publishers,

  COUNTIF(distinct_publication_years > 1)
    AS groups_with_multiple_publication_years,

  COUNTIF(distinct_full_record_variants < source_rows)
    AS groups_containing_identical_full_records

FROM repeated_groups;


-- 1.5 Test whether adding subjects resolves repeated groups

WITH subject_grain AS (
  SELECT
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,
    subjects,
    COUNT(*) AS source_rows
  FROM `universal-code-508122-p8.books_project.books`
  GROUP BY
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,
    subjects
)

SELECT
  COUNTIF(source_rows > 1)
    AS repeated_groups_after_adding_subjects,

  SUM(IF(source_rows > 1, source_rows, 0))
    AS rows_in_remaining_repeated_groups,

  SUM(IF(source_rows > 1, source_rows - 1, 0))
    AS remaining_extra_rows,

  MAX(source_rows) AS largest_remaining_group

FROM subject_grain;


-- 1.6 Investigate remaining differences after adding subjects

WITH remaining_groups AS (
  SELECT
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,
    subjects,

    COUNT(*) AS source_rows,
    COUNT(DISTINCT isbn) AS distinct_isbns,
    COUNT(DISTINCT publisher) AS distinct_publishers,
    COUNT(DISTINCT publicationyear) AS distinct_publication_years,
    COUNT(DISTINCT checkouts) AS distinct_checkout_values,

    COUNT(DISTINCT TO_JSON_STRING(STRUCT(
      isbn,
      publisher,
      publicationyear,
      checkouts
    ))) AS distinct_variants

  FROM `universal-code-508122-p8.books_project.books`

  GROUP BY
    title,
    creator,
    checkoutmonth,
    checkoutyear,
    materialtype,
    checkouttype,
    usageclass,
    subjects

  HAVING COUNT(*) > 1
)

SELECT
  COUNT(*) AS remaining_repeated_groups,
  SUM(source_rows) AS rows_in_remaining_groups,

  COUNTIF(distinct_isbns > 1) AS groups_with_multiple_isbns,
  COUNTIF(distinct_publishers > 1) AS groups_with_multiple_publishers,

  COUNTIF(distinct_publication_years > 1)
    AS groups_with_multiple_publication_years,

  COUNTIF(distinct_checkout_values > 1)
    AS groups_with_multiple_checkout_values,

  COUNTIF(distinct_variants < source_rows)
    AS groups_with_identical_remaining_variants

FROM remaining_groups;


-- 1.7 Inspect exact duplicate source rows

SELECT
  usageclass,
  checkouttype,
  materialtype,
  checkoutyear,
  checkoutmonth,
  title,
  creator,
  isbn,
  publisher,
  subjects,
  publicationyear,
  checkouts,
  COUNT(*) AS identical_row_count

FROM `universal-code-508122-p8.books_project.books`

GROUP BY
  usageclass,
  checkouttype,
  materialtype,
  checkoutyear,
  checkoutmonth,
  title,
  creator,
  isbn,
  publisher,
  subjects,
  publicationyear,
  checkouts

HAVING COUNT(*) > 1

ORDER BY identical_row_count DESC;


-- 1.8 Test the revised 11-field composite analytical grain
-- This is the grain used for the Curated transformation.

SELECT
  COUNT(*) AS repeated_groups,
  COALESCE(SUM(source_rows), 0) AS rows_in_repeated_groups,
  COALESCE(SUM(source_rows - 1), 0) AS extra_rows,
  COALESCE(MAX(source_rows), 0) AS largest_group

FROM (
  SELECT
    usageclass,
    checkouttype,
    materialtype,
    checkoutyear,
    checkoutmonth,
    title,
    creator,
    subjects,
    isbn,
    publisher,
    publicationyear,
    COUNT(*) AS source_rows

  FROM `universal-code-508122-p8.books_project.books`

  GROUP BY
    usageclass,
    checkouttype,
    materialtype,
    checkoutyear,
    checkoutmonth,
    title,
    creator,
    subjects,
    isbn,
    publisher,
    publicationyear

  HAVING COUNT(*) > 1
);


-- ============================================================
-- SECTION 2. BUILD THE CURATED TABLE
-- ============================================================

-- 2.1 Create Curated by grouping the 11 analytical grain fields
-- and summing checkouts.

CREATE OR REPLACE TABLE
  `universal-code-508122-p8.books_project.books_curated` AS

SELECT
  usageclass,
  checkouttype,
  materialtype,
  checkoutyear,
  checkoutmonth,
  title,
  creator,
  subjects,
  isbn,
  publisher,
  publicationyear,
  SUM(checkouts) AS checkouts

FROM `universal-code-508122-p8.books_project.books`

GROUP BY
  usageclass,
  checkouttype,
  materialtype,
  checkoutyear,
  checkoutmonth,
  title,
  creator,
  subjects,
  isbn,
  publisher,
  publicationyear;


-- ============================================================
-- SECTION 3. CURATED VALIDATION AND ACCEPTANCE CHECKS
-- ============================================================

-- 3.1 Check Curated row count, total checkouts, and selected
-- catalog attributes.

SELECT
  COUNT(*) AS curated_rows,
  SUM(checkouts) AS total_checkouts,
  COUNTIF(title IS NULL) AS missing_titles,
  COUNTIF(creator IS NULL) AS missing_creators,
  COUNTIF(isbn IS NULL) AS missing_isbns
FROM `universal-code-508122-p8.books_project.books_curated`;


-- 3.2 Compare Raw and Curated row counts and checkout totals.

SELECT
  'Raw' AS layer,
  COUNT(*) AS total_rows,
  SUM(checkouts) AS total_checkouts
FROM `universal-code-508122-p8.books_project.books`

UNION ALL

SELECT
  'Curated' AS layer,
  COUNT(*) AS total_rows,
  SUM(checkouts) AS total_checkouts
FROM `universal-code-508122-p8.books_project.books_curated`;


-- 3.3 Compare full-row frequencies to identify the specific
-- Raw-to-Curated record changes.

WITH raw_counts AS (
  SELECT
    TO_JSON_STRING(STRUCT(
      checkoutmonth,
      checkouts,
      checkouttype,
      checkoutyear,
      creator,
      isbn,
      materialtype,
      publicationyear,
      publisher,
      subjects,
      title,
      usageclass
    )) AS row_data,
    COUNT(*) AS raw_count
  FROM `universal-code-508122-p8.books_project.books`
  GROUP BY row_data
),

curated_counts AS (
  SELECT
    TO_JSON_STRING(STRUCT(
      checkoutmonth,
      checkouts,
      checkouttype,
      checkoutyear,
      creator,
      isbn,
      materialtype,
      publicationyear,
      publisher,
      subjects,
      title,
      usageclass
    )) AS row_data,
    COUNT(*) AS curated_count
  FROM `universal-code-508122-p8.books_project.books_curated`
  GROUP BY row_data
)

SELECT
  COALESCE(r.row_data, c.row_data) AS row_data,
  COALESCE(r.raw_count, 0) AS raw_count,
  COALESCE(c.curated_count, 0) AS curated_count,
  COALESCE(r.raw_count, 0) - COALESCE(c.curated_count, 0)
    AS row_count_difference

FROM raw_counts r

FULL OUTER JOIN curated_counts c
  ON r.row_data = c.row_data

WHERE COALESCE(r.raw_count, 0) != COALESCE(c.curated_count, 0)

ORDER BY ABS(row_count_difference) DESC;


-- 3.4 Validate checkout measures.

SELECT
  COUNT(*) AS total_rows,
  COUNTIF(checkouts IS NULL) AS null_checkouts,
  COUNTIF(checkouts = 0) AS zero_checkouts,
  COUNTIF(checkouts < 0) AS negative_checkouts,
  MIN(checkouts) AS minimum_checkouts,
  MAX(checkouts) AS maximum_checkouts,
  AVG(checkouts) AS average_checkouts,
  SUM(checkouts) AS total_checkouts

FROM `universal-code-508122-p8.books_project.books_curated`;


-- 3.5 Validate checkout dates.

SELECT
  COUNT(*) AS total_rows,

  COUNTIF(checkoutyear IS NULL)
    AS null_checkout_years,

  COUNTIF(checkoutyear < 1900 OR checkoutyear > 2026)
    AS invalid_checkout_years,

  COUNTIF(checkoutmonth IS NULL)
    AS null_checkout_months,

  COUNTIF(checkoutmonth < 1 OR checkoutmonth > 12)
    AS invalid_checkout_months,

  MIN(checkoutyear) AS earliest_checkout_year,
  MAX(checkoutyear) AS latest_checkout_year,
  MIN(checkoutmonth) AS earliest_checkout_month,
  MAX(checkoutmonth) AS latest_checkout_month

FROM `universal-code-508122-p8.books_project.books_curated`;


-- 3.6 Acceptance Check 1:
-- Confirm uniqueness of the revised 11-field composite grain.
-- Expected result: zero repeated groups and zero excess rows.

SELECT
  COUNT(*) AS repeated_groups,
  COALESCE(SUM(source_rows), 0) AS rows_in_repeated_groups,
  COALESCE(SUM(source_rows - 1), 0) AS extra_rows,
  COALESCE(MAX(source_rows), 0) AS largest_group

FROM (
  SELECT
    usageclass,
    checkouttype,
    materialtype,
    checkoutyear,
    checkoutmonth,
    title,
    creator,
    subjects,
    isbn,
    publisher,
    publicationyear,
    COUNT(*) AS source_rows

  FROM `universal-code-508122-p8.books_project.books_curated`

  GROUP BY
    usageclass,
    checkouttype,
    materialtype,
    checkoutyear,
    checkoutmonth,
    title,
    creator,
    subjects,
    isbn,
    publisher,
    publicationyear

  HAVING COUNT(*) > 1
);


-- 3.7 Check missing catalog attributes.

SELECT
  COUNT(*) AS total_rows,
  COUNTIF(title IS NULL) AS missing_titles,
  COUNTIF(creator IS NULL) AS missing_creators,
  COUNTIF(isbn IS NULL) AS missing_isbns,
  COUNTIF(publisher IS NULL) AS missing_publishers,
  COUNTIF(subjects IS NULL) AS missing_subjects,
  COUNTIF(publicationyear IS NULL) AS missing_publicationyears,
  COUNTIF(materialtype IS NULL) AS missing_materialtypes,
  COUNTIF(checkouttype IS NULL) AS missing_checkouttypes,
  COUNTIF(usageclass IS NULL) AS missing_usageclasses

FROM `universal-code-508122-p8.books_project.books_curated`;


-- 3.8 Acceptance Check 2:
-- Confirm all expected months from January 2006 through
-- December 2025 are represented and summarize sample coverage.

WITH expected_months AS (
  SELECT
    EXTRACT(YEAR FROM month_date) AS checkoutyear,
    EXTRACT(MONTH FROM month_date) AS checkoutmonth

  FROM UNNEST(
    GENERATE_DATE_ARRAY(
      DATE '2006-01-01',
      DATE '2025-12-01',
      INTERVAL 1 MONTH
    )
  ) AS month_date
),

monthly AS (
  SELECT
    checkoutyear,
    checkoutmonth,
    COUNT(*) AS sampled_records,
    SUM(checkouts) AS sampled_checkouts

  FROM `universal-code-508122-p8.books_project.books_curated`

  WHERE checkoutyear BETWEEN 2006 AND 2025

  GROUP BY checkoutyear, checkoutmonth
)

SELECT
  COUNT(*) AS expected_months,
  COUNTIF(m.sampled_records IS NOT NULL) AS months_with_records,
  COUNTIF(m.sampled_records IS NULL) AS months_missing,
  MIN(m.sampled_records) AS minimum_monthly_records,
  MAX(m.sampled_records) AS maximum_monthly_records,
  ROUND(AVG(m.sampled_records), 2) AS average_monthly_records,
  MIN(m.sampled_checkouts) AS minimum_monthly_checkouts,
  MAX(m.sampled_checkouts) AS maximum_monthly_checkouts

FROM expected_months e

LEFT JOIN monthly m
  USING (checkoutyear, checkoutmonth);


-- 3.9 Inspect monthly sample coverage in detail.

SELECT
  checkoutyear,
  checkoutmonth,
  COUNT(*) AS sampled_records,
  SUM(checkouts) AS sampled_checkouts

FROM `universal-code-508122-p8.books_project.books_curated`

GROUP BY checkoutyear, checkoutmonth

ORDER BY checkoutyear, checkoutmonth;


-- 3.10 Identify months with unusually low record counts.
-- This query was used to investigate May 2020.

SELECT
  checkoutyear,
  checkoutmonth,
  COUNT(*) AS sampled_records,
  SUM(checkouts) AS sampled_checkouts

