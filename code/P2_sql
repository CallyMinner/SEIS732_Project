-- ============================================================
-- SECTION 4. PUBLICATION-YEAR INVESTIGATION AND CLEANING
-- ============================================================

-- 4.1 Check publication-year completeness and basic numeric
-- anomalies in the original Curated publicationyear field.

SELECT
  COUNT(*) AS total_rows,

  COUNTIF(publicationyear IS NULL)
    AS null_publication_years,

  COUNTIF(
    publicationyear IS NOT NULL
    AND TRIM(publicationyear) = ''
  ) AS blank_publication_years,

  COUNTIF(
    publicationyear IS NOT NULL
    AND TRIM(publicationyear) != ''
    AND SAFE_CAST(publicationyear AS INT64) IS NULL
  ) AS nonnumeric_publication_years,

  COUNTIF(
    SAFE_CAST(publicationyear AS INT64) < 1000
  ) AS publication_years_below_1000,

  COUNTIF(
    SAFE_CAST(publicationyear AS INT64) > 2026
  ) AS publication_years_after_2026,

  MIN(SAFE_CAST(publicationyear AS INT64))
    AS earliest_publication_year,

  MAX(SAFE_CAST(publicationyear AS INT64))
    AS latest_publication_year

FROM `universal-code-508122-p8.books_project.books_curated`;


-- 4.2 Inspect unusual publication-year values.

SELECT
  publicationyear,
  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts,

  CASE
    WHEN SAFE_CAST(publicationyear AS INT64) IS NULL
      THEN 'Nonnumeric'
    WHEN SAFE_CAST(publicationyear AS INT64) < 1000
      THEN 'Below 1000'
    WHEN SAFE_CAST(publicationyear AS INT64) > 2026
      THEN 'After 2026'
    ELSE 'Other'
  END AS issue_type

FROM `universal-code-508122-p8.books_project.books_curated`

WHERE
  publicationyear IS NOT NULL
  AND (
    SAFE_CAST(publicationyear AS INT64) IS NULL
    OR SAFE_CAST(publicationyear AS INT64) < 1000
    OR SAFE_CAST(publicationyear AS INT64) > 2026
  )

GROUP BY publicationyear, issue_type

ORDER BY record_count DESC

LIMIT 50;


-- 4.3 Categorize original publication-year formats.

SELECT
  CASE
    WHEN REGEXP_CONTAINS(
      TRIM(publicationyear),
      r'(?i)^\[?\s*c?\s*\d{4}\.?\s*\]?$'
    )
      THEN 'Standard year with cataloging notation'

    WHEN REGEXP_CONTAINS(
      TRIM(publicationyear),
      r'\d{4}\s*[-/]\s*\d{2,4}'
    )
      THEN 'Publication year range'

    WHEN REGEXP_CONTAINS(
      TRIM(publicationyear),
      r'\d{4}'
    )
      THEN 'Year with additional text'

    ELSE 'Other or no four-digit year'
  END AS format_category,

  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts,

  ARRAY_AGG(
    DISTINCT publicationyear
    IGNORE NULLS
    LIMIT 10
  ) AS example_values

FROM `universal-code-508122-p8.books_project.books_curated`

WHERE
  publicationyear IS NOT NULL
  AND SAFE_CAST(publicationyear AS INT64) IS NULL

GROUP BY format_category

ORDER BY record_count DESC;


-- 4.4 Inspect publication-year values outside the standard
-- year format.

SELECT
  publicationyear,
  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts

FROM `universal-code-508122-p8.books_project.books_curated`

WHERE
  publicationyear IS NOT NULL
  AND NOT REGEXP_CONTAINS(
    TRIM(publicationyear),
    r'(?i)^\[?\s*c?\s*\d{4}\.?\s*\]?$'
  )

GROUP BY publicationyear

ORDER BY record_count DESC

LIMIT 50;


-- 4.5 Test publication-year cleaning rules and classify
-- source values before creating the supporting table.

WITH classified AS (
  SELECT
    publicationyear,
    checkouts,
    TRIM(publicationyear) AS original_value

  FROM `universal-code-508122-p8.books_project.books_curated`
),

cleaned AS (
  SELECT
    *,

    CASE
      -- Explicit publication-year prefix, such as p2009.
      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^p\s*\d{4}\.?\s*$'
      )
        THEN SAFE_CAST(
          REGEXP_EXTRACT(original_value, r'(\d{4})')
          AS INT64
        )

      -- Publication year followed by copyright year.
      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\s*,\s*c\s*\d{4}\.?\s*$'
      )
        THEN SAFE_CAST(
          REGEXP_EXTRACT(original_value, r'^(\d{4})')
          AS INT64
        )

      -- Bracketed or uncertain publication year.
      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\[\s*\d{4}\??\s*\]\.?\s*$'
      )
        THEN SAFE_CAST(
          REGEXP_EXTRACT(original_value, r'(\d{4})')
          AS INT64
        )

      -- Plain four-digit publication year.
      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\.?\s*$'
      )
        THEN SAFE_CAST(
          REGEXP_EXTRACT(original_value, r'(\d{4})')
          AS INT64
        )

      ELSE NULL
    END AS publication_year_clean,

    CASE
      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^p\s*\d{4}\.?\s*$'
      )
        THEN 'Publication prefix'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\s*,\s*c\s*\d{4}\.?\s*$'
      )
        THEN 'Publication and copyright dates'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\[\s*\d{4}\??\s*\]\.?\s*$'
      )
        THEN 'Bracketed or uncertain year'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\.?\s*$'
      )
        THEN 'Plain publication year'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^c\s*\d{4}\.?\s*$|^©\s*\d{4}\.?\s*$'
      )
        THEN 'Copyright-only year'

      WHEN original_value IS NULL
        THEN 'Missing source value'

      ELSE 'Unrecognized or non-year metadata'
    END AS cleaning_category

  FROM classified
)

SELECT
  cleaning_category,
  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts,
  COUNT(publication_year_clean) AS successfully_cleaned_records,

  ARRAY_AGG(
    DISTINCT publicationyear
    IGNORE NULLS
    LIMIT 10
  ) AS example_original_values

FROM cleaned

GROUP BY cleaning_category

ORDER BY record_count DESC;


