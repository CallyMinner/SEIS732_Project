      WHEN REGEXP_CONTAINS(
        original_value, r'^\[\s*\d{4}\??\s*\]\.?\s*$'
      ) THEN 'Bracketed or uncertain year'

      WHEN REGEXP_CONTAINS(
        original_value, r'^\d{4}\.?\s*$'
      ) THEN 'Plain publication year'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^c\s*\d{4}\.?\s*$|^©\s*\d{4}\.?\s*$'
      ) THEN 'Copyright-only year'

      WHEN original_value IS NULL THEN 'Missing source value'

      ELSE 'Unrecognized or non-year metadata'
    END AS cleaning_category

  FROM classified
)

SELECT
  cleaning_category,
  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts,
  COUNT(publication_year_clean) AS successfully_cleaned_records,
  MIN(publication_year_clean) AS minimum_clean_year,
  MAX(publication_year_clean) AS maximum_clean_year

FROM cleaned

GROUP BY cleaning_category

ORDER BY record_count DESC;


-- 4.7 Inspect records with both publication and copyright years.

SELECT
  publicationyear,
  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts

FROM `universal-code-508122-p8.books_project.books_curated`

WHERE REGEXP_CONTAINS(
  TRIM(publicationyear),
  r'^\d{4}\s*,\s*c\s*\d{4}\.?\s*$'
)

GROUP BY publicationyear

ORDER BY record_count DESC;


-- 4.8 Extract and compare publication and copyright years
-- for records containing both dates.

SELECT
  publicationyear,

  SAFE_CAST(
    REGEXP_EXTRACT(
      TRIM(publicationyear),
      r'^(\d{4})'
    ) AS INT64
  ) AS publication_year_clean,

  SAFE_CAST(
    REGEXP_EXTRACT(
      TRIM(publicationyear),
      r',\s*c\s*(\d{4})'
    ) AS INT64
  ) AS copyright_year_clean,

  COUNT(*) AS record_count,
  SUM(checkouts) AS total_checkouts

FROM `universal-code-508122-p8.books_project.books_curated`

WHERE REGEXP_CONTAINS(
  TRIM(publicationyear),
  r'^\d{4}\s*,\s*c\s*\d{4}\.?\s*$'
)

GROUP BY
  publicationyear,
  publication_year_clean,
  copyright_year_clean

ORDER BY record_count DESC;


-- 4.9 Create the supporting publication-year table.
-- The original publicationyear value is retained.
-- Publication and copyright years are extracted separately.

CREATE OR REPLACE TABLE
  `universal-code-508122-p8.books_project.books_final` AS

WITH source AS (
  SELECT
    *,
    TRIM(publicationyear) AS original_value

  FROM `universal-code-508122-p8.books_project.books_curated`
),

classified AS (
  SELECT
    *,

    CASE
      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^p\s*\d{4}\.?\s*$'
      )
        THEN 'PUBLICATION_PREFIX'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\s*,\s*c\s*\d{4}\.?\s*$'
      )
        THEN 'PUBLICATION_AND_COPYRIGHT'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\[\s*\d{4}\??\s*\]\.?\s*$'
      )
        THEN 'BRACKETED_UNCERTAIN'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'^\d{4}\.?\s*$'
      )
        THEN 'PLAIN_YEAR'

      WHEN REGEXP_CONTAINS(
        original_value,
        r'(?i)^c\s*\d{4}\.?\s*$|^©\s*\d{4}\.?\s*$'
      )
        THEN 'COPYRIGHT_ONLY'

      WHEN original_value IS NULL OR original_value = ''
        THEN 'MISSING'

      ELSE 'UNRECOGNIZED'
    END AS publication_year_status

  FROM source
)

SELECT
  * EXCEPT(original_value),

  CASE
    WHEN publication_year_status IN (
      'PLAIN_YEAR',
      'BRACKETED_UNCERTAIN',
      'PUBLICATION_PREFIX',
      'PUBLICATION_AND_COPYRIGHT'
    )
    THEN SAFE_CAST(
      REGEXP_EXTRACT(original_value, r'(\d{4})')
      AS INT64
    )
    ELSE NULL
  END AS publication_year_clean,

  CASE
    WHEN publication_year_status IN (
      'PUBLICATION_AND_COPYRIGHT',
      'COPYRIGHT_ONLY'
    )
    THEN SAFE_CAST(
      REGEXP_EXTRACT(
        original_value,
        r'(?i)(?:,\s*c|^c|^©)\s*(\d{4})'
      )
      AS INT64
    )
    ELSE NULL
  END AS copyright_year_clean

FROM classified;


-- 4.10 Validate the supporting table.

SELECT
  COUNT(*) AS total_records,
  SUM(checkouts) AS total_checkouts,
  COUNT(publication_year_clean) AS cleaned_publication_years,
  COUNT(copyright_year_clean) AS cleaned_copyright_years

FROM `universal-code-508122-p8.books_project.books_final`;


-- 4.11 Compare publication year with sampled checkout activity.

SELECT
  publication_year_clean,
  COUNT(*) AS total_records,
  SUM(checkouts) AS total_sampled_checkouts,
  ROUND(AVG(checkouts), 2) AS average_checkouts

FROM `universal-code-508122-p8.books_project.books_final`

WHERE publication_year_clean IS NOT NULL

GROUP BY publication_year_clean

ORDER BY publication_year_clean;


